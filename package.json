{
	"name": "csci332-project",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "rm worker-configuration.d.ts && wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@mdsvex/plugin-anchors": "^0.1.0",
		"@mdsvex/plugin-callouts": "^0.1.0",
		"@mdsvex/plugin-code-blocks": "^0.1.0",
		"@mdsvex/plugin-diagram": "^0.1.0",
		"@mdsvex/plugin-elements": "^0.1.0",
		"@mdsvex/plugin-embeds": "^0.1.0",
		"@mdsvex/plugin-external-links": "^0.1.0",
		"@mdsvex/plugin-figures": "^0.1.0",
		"@mdsvex/plugin-link-check": "^0.1.0",
		"@mdsvex/plugin-numbering": "^0.1.0",
		"@mdsvex/plugin-page-data": "^0.1.0",
		"@mdsvex/plugin-steps": "^0.1.0",
		"@mdsvex/plugin-tabs": "^0.1.0",
		"@mdsvex/plugin-toc": "^0.1.0",
		"@mdsvex/prettier-plugin": "^0.1.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-devtools-svelte": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@vitejs/devtools": "^0.8.3",
		"@vitejs/devtools-rolldown": "^0.8.3",
		"@vitejs/devtools-vite": "^0.8.3",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.14.0",
		"mdsvex": "^1.0.0",
		"mermaid": "^12.3.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	}
}
